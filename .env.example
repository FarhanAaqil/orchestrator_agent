# ============================================================
# .env.example — Orchestrator Agent v2
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is listed in .gitignore.
#
# IMPORTANT: If any of these keys were ever committed to git
# history, rotate them immediately even after a history purge.
# ============================================================

# ── LLM Provider (Required) ──
# Groq API key — get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── GitHub Integration (Optional) ──
# Personal access token with repo read scope
GITHUB_TOKEN=your_github_token_here

# ── LinkedIn (Experimental — not in supported agent set) ──
LINKEDIN_EMAIL=your_linkedin_email_here
LINKEDIN_PASSWORD=your_linkedin_password_here

# ── Content Publishing (Experimental — gated behind approval gate in v2) ──
# Hashnode personal access token — https://hashnode.com/settings/developer
HASHNODE_TOKEN=your_hashnode_token_here
HASHNODE_PUBLICATION_ID=your_hashnode_publication_id_here

# Dev.to API key — https://dev.to/settings/extensions
DEVTO_API_KEY=your_devto_api_key_here

# ── Email (Experimental — gated behind approval gate in v2) ──
# Gmail address and App Password (not your login password)
# Enable App Passwords: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=your_gmail_address_here
EMAIL_APP_PASSWORD=your_gmail_app_password_here

# ── Personal Details (used in agent prompts) ──
PERSONAL_NAME=Your Name
AFFILIATION=Your Institution
DEPARTMENT=Your Department

# ── Router Settings (Optional — defaults shown) ──
# Confidence threshold below which router returns needs_clarification instead of routing
ROUTER_CONFIDENCE_THRESHOLD=0.6

# ── Auth (Required for non-local deployments) ──
# Bearer token for the FastAPI auth middleware
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
API_BEARER_TOKEN=your_bearer_token_here

# ── Feature Flags ──
# Set to false to disable the second self-reflection LLM call (halves API costs)
ENABLE_SELF_REFLECTION=true
