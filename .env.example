# ==============================================================================
# .env.example — Orchestrator Agent v2
# Copy this file to .env and configure your values.
# NEVER commit your real .env to version control — it is ignored via .gitignore.
# ==============================================================================

# [Required] Groq Cloud API Key for LLM routing and core agent generation
GROQ_API_KEY=gsk_your_groq_api_key_here

# [Optional] Bearer token for FastAPI route protection (Required for production deployments)
AUTH_TOKEN=your_secure_bearer_token_here

# [Optional] Path to local SQLite database file (Defaults to database/orchestrator.db)
DATABASE_PATH=database/orchestrator.db

# [Optional] Path to persistent ChromaDB directory (Defaults to chroma_db)
CHROMA_DB_DIR=chroma_db

# [Optional] Groq LLM model name used for routing and classification (Defaults to llama-3.3-70b-versatile)
ROUTER_MODEL=llama-3.3-70b-versatile

# [Optional] Confidence threshold [0.0 - 1.0] below which router flags ClarificationNeeded (Defaults to 0.6)
ROUTER_CONFIDENCE_THRESHOLD=0.6

# [Optional] Application environment name: development, staging, production (Defaults to development)
ENVIRONMENT=development

# [Optional] Service semantic version string (Defaults to 2.0.0-alpha)
APP_VERSION=2.0.0-alpha

# ── Experimental / Legacy Integrations (Gated in experimental/) ────────────────
# [Optional] GitHub personal access token with repo read access
GITHUB_TOKEN=ghp_your_github_token_here

# [Optional] Dev.to API key for tech blog publishing
DEVTO_API_KEY=your_devto_api_key_here

# [Optional] Hashnode personal access token for publishing
HASHNODE_TOKEN=your_hashnode_token_here

# [Optional] Hashnode publication ID
HASHNODE_PUBLICATION_ID=your_hashnode_publication_id_here
