# ==============================================================================
# Orchestrator Agent — Caddyfile (Zero-Config SSL, HTTP/3 & Modern Edge Proxy)
# ==============================================================================

:80, :443 {
    # Automatic modern compression
    encode gzip zstd

    # Production security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # Static assets edge cache policy
    @static path /static/*
    header @static {
        Cache-Control "public, max-age=604800, immutable"
    }

    # Upstream load balancer with health checks & least-connections policy
    reverse_proxy orchestrator:8000 {
        lb_policy least_conn
        lb_try_duration 5s

        # Active health check against FastAPI /health route
        health_uri /health
        health_interval 10s
        health_timeout 3s
        health_status 200

        # Buffer tuning for interactive LLM output
        flush_interval -1
    }
}
